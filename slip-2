Q2: Write a program to solve the Water Jug Problem using BFS


from collections import deque
def water_jug():
visited = set()
queue = deque([(0, 0)])
while queue:
x, y = queue.popleft()
if (x, y) in visited:
continue
visited.add((x, y))
if x == 2 or y == 2:
print("Solution:", (x, y))
return
states =
[(4, y),# Fill 4-litre jug
(x, 3),# Fill 3-litre jug
(0, y),# Empty 4-litre jug
(x, 0), # Empty 3-litre jug
# Pour 4-litre jug into 3-litre jug
(max(0, x - (3 - y)), min(3, x + y)),
# Pour 3-litre jug into 4-litre jug
(min(4, x + y), max(0, y - (4 - x)))
]
for state in states:
if state not in visited:
queue.append(state)water_jug()


 : Write a program to implement the Backtracking Algorithm for solving a constraint 
satisfaction problem.
 
For the given graph, vertices are 1, 2, 3, 4, 5. Each vertex is connected to every other vertex, so 
adjacent vertices must have different colors.
We will use 5 colors: Red, Green, Blue, Yellow, Orange
Python Program :
# Backtracking Algorithm for CSP
# Graph Coloring Problem
# Vertices
vertices = [1, 2, 3, 4, 5]
# Available colors
colors = ['Red', 'Green', 'Blue', 'Yellow', 'Orange']
# Graph: every vertex is connected to every other vertex
graph = {
 1: [2, 3, 4, 5],
 2: [1, 3, 4, 5],
 3: [1, 2, 4, 5],
 4: [1, 2, 3, 5],
 5: [1, 2, 3, 4]
}
# Check whether assigning a color is safe
def is_safe(vertex, color, assignment):
 for neighbour in graph[vertex]:
 if neighbour in assignment:
 if assignment[neighbour] == color:
 return False
 return True
# Backtracking function
def backtracking(assignment):
 # All vertices are assigned
 if len(assignment) == len(vertices):
 return True
 # Select an unassigned vertex
 for vertex in vertices:
 if vertex not in assignment:
 # Try each available color
 for color in colors:
 if is_safe(vertex, color, assignment):
 # Assign color
 assignment[vertex] = color
 # Recursively solve
 if backtracking(assignment):
 return True
 # Backtrack
 del assignment[vertex]
 return False
 return False
# Start with empty assignment
assignment = {}
if backtracking(assignment):
 print("Solution:")
 for vertex in vertices:
 print("Vertex", vertex, "->", assignment[vertex])
else:
 print("No solution exists.")
